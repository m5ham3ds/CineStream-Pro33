rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    // Admins Collection: Access based on /admins/{uid} enabled == true
    match /admins/{adminId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == adminId);
      allow write: if isAdmin();
    }

    // App Configuration: Read for authenticated users, write only for admins
    match /config/app {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Search Order Configuration: Public read for global extension order, write only for admins
    match /config/search_order {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Features Configuration: Read for authenticated users, write only for admins
    match /config/features {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Economy Configuration: Read for authenticated users, write only for admins
    match /config/economy {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Prohibit any access to deprecated config paths
    match /config/{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // Any authenticated user can read public profiles or own profile
      allow read: if isAuthenticated();
      
      // User can create their own document with restricted initial fields
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) &&
        (!('subscriptionTier' in request.resource.data) || request.resource.data.subscriptionTier == 'free' || request.resource.data.subscriptionTier == 'FREE') &&
        (!('plan' in request.resource.data) || request.resource.data.plan == 'free') &&
        (!('planId' in request.resource.data) || request.resource.data.planId == 'free') &&
        (!('durationDays' in request.resource.data) || request.resource.data.durationDays == 0) &&
        (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == 'none' || request.resource.data.subscriptionStatus == 'NONE' || request.resource.data.subscriptionStatus == 'inactive' || request.resource.data.subscriptionStatus == 'INACTIVE' || request.resource.data.subscriptionStatus == '') &&
        (!('subscriptionSource' in request.resource.data) || request.resource.data.subscriptionSource == 'LEGACY') &&
        (!('pointsBalance' in request.resource.data) || request.resource.data.pointsBalance == 0) &&
        (!('totalPointsEarned' in request.resource.data) || request.resource.data.totalPointsEarned == 0) &&
        (!('totalPointsSpent' in request.resource.data) || request.resource.data.totalPointsSpent == 0) &&
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false) &&
        (!('isActive' in request.resource.data) || request.resource.data.isActive == true) &&
        (!('banReason' in request.resource.data) || request.resource.data.banReason == '') &&
        (!('canWatch' in request.resource.data) || request.resource.data.canWatch == true) &&
        (!('canDownload' in request.resource.data) || request.resource.data.canDownload == true) &&
        (!('canChat' in request.resource.data) || request.resource.data.canChat == true) &&
        (!('canStory' in request.resource.data) || request.resource.data.canStory == true) &&
        (!('canP2P' in request.resource.data) || request.resource.data.canP2P == true) &&
        (!('canComment' in request.resource.data) || request.resource.data.canComment == true) &&
        (!('canUpload' in request.resource.data) || request.resource.data.canUpload == true) &&
        (!('canRequest' in request.resource.data) || request.resource.data.canRequest == true) &&
        !request.resource.data.keys().hasAny([
          'deviceLimit', 'maxDevices', 'allowedQuality', 'downloadLimit',
          'subscriptionExpiresAt', 'subscriptionStartedAt', 'subscriptionReferenceId',
          'proExpiresAt', 'proPlan',
          'banExpiresAt',
          'watchBan', 'downloadBan', 'chatBan', 'storyBan', 'p2pBan',
          'offlineDaysOverride', 'forcedAdsOverride',
          'admin', 'isAdmin'
        ]);

      // User updates in TEMPORARY ECONOMY MODE: Owner can update profile, economy, and subscription fields.
      // Strict denial is maintained against administrative privileges, bans, and technical quality/download limits.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'admin', 'isAdmin',
                  'deviceLimit', 'maxDevices', 'allowedQuality', 'downloadLimit',
                  'isActive', 'isBanned', 'banReason', 'banExpiresAt',
                  'canWatch', 'canDownload', 'canChat', 'canStory', 'canP2P',
                  'watchBan', 'downloadBan', 'chatBan', 'storyBan', 'p2pBan',
                  'offlineDaysOverride', 'forcedAdsOverride'])
      );

      // Only admin can delete user document
      allow delete: if isAdmin();

      // User subcollections (Library, History, Watched Episodes)
      match /library/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /history/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /watched_episodes/{episodeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User Point Transactions Ledger: In TEMPORARY ECONOMY MODE, allows owner self-audit logging
      match /point_transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin() || (isOwner(userId) && request.resource.data.userId == userId);
      }

      // User Task Claims: In TEMPORARY ECONOMY MODE, allows owner self-claim recording
      match /task_claims/{claimId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin() || (isOwner(userId) && request.resource.data.userId == userId);
      }

      // User Settings (Notification Preferences)
      match /settings/notifications {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if (isOwner(userId) || isAdmin()) &&
          !request.resource.data.keys().hasAny(['role', 'admin', 'isAdmin', 'isPremium', 'subscriptionTier', 'isBanned', 'banReason']);
      }

      match /settings/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User FCM Tokens: Device-level tokens; strictly private to owner and admin
      match /fcmTokens/{installationId} {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if (isOwner(userId) || isAdmin()) &&
          request.resource.data.installationId == installationId &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0 &&
          request.resource.data.platform == 'android' &&
          request.resource.data.deviceModel is string &&
          request.resource.data.osVersion is string &&
          request.resource.data.appVersion is string &&
          request.resource.data.isActive == true &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.lastSeenAt == request.time &&
          !request.resource.data.keys().hasAny(['role', 'admin', 'isAdmin', 'isPremium', 'subscriptionTier', 'uid', 'userId']);

        allow update: if isAdmin() || (
          isOwner(userId) &&
          request.resource.data.installationId == resource.data.installationId &&
          request.resource.data.installationId == installationId &&
          request.resource.data.platform == resource.data.platform &&
          request.resource.data.platform == 'android' &&
          (request.resource.data.createdAt == resource.data.createdAt || request.resource.data.createdAt == request.time) &&
          (request.resource.data.updatedAt == resource.data.updatedAt || request.resource.data.updatedAt == request.time) &&
          (request.resource.data.lastSeenAt == resource.data.lastSeenAt || request.resource.data.lastSeenAt == request.time) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0 &&
          request.resource.data.deviceModel is string &&
          request.resource.data.osVersion is string &&
          request.resource.data.appVersion is string &&
          request.resource.data.isActive is bool &&
          (!('deactivationReason' in request.resource.data) || request.resource.data.deactivationReason is string) &&
          (!('deactivatedAt' in request.resource.data) || request.resource.data.deactivatedAt == request.time || request.resource.data.deactivatedAt == resource.data.deactivatedAt) &&
          !request.resource.data.keys().hasAny(['role', 'admin', 'isAdmin', 'isPremium', 'subscriptionTier', 'uid', 'userId'])
        );

        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Managed Extensions Catalog: Public read for global extension control, write only for admins
    match /managed_extensions/{extensionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy Extensions Catalog (Retained for backward compatibility): Public read, write only for admins
    match /extensions/{extensionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications: Read for authenticated users, write only for admins
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // App Updates Catalog: Read for authenticated users, write only for admins
    match /app_updates/{updateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Pro Subscription Upgrade Requests: User can submit PENDING request for themselves; Admin can review and resolve
    match /pro_requests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.status == 'PENDING' || request.resource.data.status == 'pending') &&
        !request.resource.data.keys().hasAny([
          'approvedBy', 'approvedAt', 'grantedBy', 'grantSource',
          'subscriptionTier', 'subscriptionStatus', 'subscriptionSource',
          'subscriptionReferenceId', 'subscriptionStartedAt', 'subscriptionExpiresAt',
          'isPremium', 'isPro', 'proPlan', 'proExpiresAt',
          'admin', 'isAdmin', 'role'
        ]);
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Reward Tasks Catalog: Authenticated users can read active tasks; Admin can manage
    match /reward_tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Leaderboard & Weekly Rankings: Authenticated users can read; Admin/server manages
    match /leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Leaderboard History Archives: Authenticated users can read; Admin/server manages
    match /leaderboard_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Reports: Any authenticated user can submit; only admin can read all and resolve
    match /reports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy == null) &&
        (!('resolvedAt' in request.resource.data) || request.resource.data.resolvedAt == null);
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Support Conversations: User ↔ Admin communication
    match /support_conversations/{conversationId} {
      // User can read their own support conversation; Admin can read all
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );

      // User can create their own support conversation
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.status == 'open' || request.resource.data.status == 'pending');

      // User can update their own conversation metadata, but cannot change userId or createdAt
      // Admin can update all fields (e.g. status, admin notes)
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)
      );

      // Only Admin can delete support conversations
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        // User can read messages in their own support conversation; Admin can read all
        allow read: if isAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/support_conversations/$(conversationId)).data.userId == request.auth.uid
        );

        // User can send messages with senderId == auth.uid and senderRole == 'user'
        // Admin can send messages with senderRole == 'admin'
        allow create: if isAuthenticated() && (
          isAdmin() || (
            get(/databases/$(database)/documents/support_conversations/$(conversationId)).data.userId == request.auth.uid &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.senderRole == 'user'
          )
        );

        // Messages cannot be modified or deleted by normal users; only Admin can moderate
        allow update, delete: if isAdmin();
      }
    }

    // Conversations & Messages (Social)
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && request.auth.uid in resource.data.participants)
      );
      allow create: if isAuthenticated() &&
        (request.auth.uid in request.resource.data.participants) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canChat != false &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.chatBan != true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && request.auth.uid in resource.data.participants)
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && resource != null && request.auth.uid in resource.data.participants
      );
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canChat != false &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.chatBan != true &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
        allow update, delete: if isAuthenticated() && (
          isAdmin() ||
          (resource != null && resource.data.senderId == request.auth.uid)
        );
      }
    }

    // Stories (Social)
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canStory != false &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storyBan != true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Audit Logs: Strictly Admin only (/auditLogs/{logId})
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Prohibit deprecated /audit_logs
    match /audit_logs/{document=**} {
      allow read, write: if false;
    }
  }
}
